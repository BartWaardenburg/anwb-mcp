{
  "name": "anwb-mcp",
  "version": "0.3.1",
  "packageManager": "pnpm@10.28.1",
  "description": "MCP server for ANWB traffic information, route planning, and location search in the Netherlands",
  "type": "module",
  "bin": {
    "anwb-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartwaardenburg/anwb-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "anwb",
    "traffic",
    "route-planner",
    "incidents",
    "netherlands",
    "verkeer",
    "routeplanner",
    "automation",
    "ai",
    "typescript",
    "nodejs"
  ],
  "author": "Bart Waardenburg",
  "license": "MIT",
  "mcpName": "io.github.BartWaardenburg/anwb-mcp",
  "bugs": {
    "url": "https://github.com/bartwaardenburg/anwb-mcp/issues"
  },
  "homepage": "https://github.com/bartwaardenburg/anwb-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "release-it": "^21.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
